// A settings panel, 320x480 -- the size of the screen this is really for.
//
// The window is exactly the panel on the bench: an ST7796 over SPI on a Pico 2 W. Nothing here
// knows that, which is the point. `imui` draws through a `Painter`, this program supplies one made
// of cairo, and the same `frame` function would take one made of PlutoVG on the board.
//
// **The interesting part is not the widgets, it is what gets repainted.** Every frame is recorded
// into a command list, compared with the previous frame's, and only the horizontal bands that
// differ are drawn for real. The readout at the bottom is the number of rows that had to be
// redrawn -- on a desktop that saves some rasterizing, and on the board it is the difference
// between 300 KB over SPI every frame and a couple of KB.

import sh.sysl.imui.*
import sh.sysl.cairo.*
import sh.sysl.cairo.c
import sh.sysl.sdl3
import sh.sysl.sdl3.c as sdl3c
import sysl.slices.as_ptr

const W: int = 320
const H: int = 480

// Sixteen bands of thirty rows. More bands means finer damage and more window-setting commands to
// the panel; this is the ratio that has felt right on a screen this shape.
const BANDS: usize = 16

// A frame is about sixty primitives with everything on screen. Four times that is room to grow
// without being wasteful -- and if it is ever not enough, `overflowed` says so and the frame is
// repainted whole rather than wrongly.
const MAX_CMDS: usize = 256

// ---------------------------------------------------------------------------------------------
// The backend: `imui`'s four primitives and two questions, in cairo.
// ---------------------------------------------------------------------------------------------

// **This is the whole of what a backend costs**, and it is worth reading as the specification of
// the seam rather than as demo code. There is no state beyond the cairo context and the font's
// height, because a painter is asked to do one thing at a time and never asked to remember.
struct CairoPainter
    cr: &Context
    ascent: real
    height: int

impl Painter for CairoPainter
    fill_rect(*self, r: Rect, color: u32)
        if r.is_empty() then return

        source(self.cr, color)
        self.cr.rectangle(real(r.x), real(r.y), real(r.w), real(r.h))
        self.cr.fill()
    end fill_rect

    // `imui` positions text by the top-left of its box and cairo draws from a baseline, so the
    // conversion happens here -- which is where the font is, and therefore the only place that can
    // do it.
    //
    // **It goes to the extern rather than to `Context.show_text`, and that is not an optimisation.**
    // The binding's method converts the string with `sysl.text.cstring`, which makes heap storage --
    // and `imui` is `@no_alloc`, so instantiating its generics with a painter that reaches an
    // allocator is refused (card 0087). Terminating into a buffer this function owns costs nothing
    // and keeps the library's promise intact for every backend, which is the point of having it.
    draw_text(*self, x: int, y: int, s: string, color: u32)
        var buf: [TEXT_MAX]u8

        source(self.cr, color)
        self.cr.move_to(real(x), real(y) + self.ascent)
        // Straight to C, on purpose: `Context.show_text` takes a `string` and allocates a
        // NUL-terminated copy of it, which in a frame loop is a copy per label per frame. The
        // buffer above is this frame's, so the raw call is the one that costs nothing. Naming
        // cairo's C layer `c` is what makes that visible rather than looking like an internal.
        c.show_text(self.cr.handle, terminate(s, buf[0..<TEXT_MAX]))
    end draw_text

    set_clip(*self, r: Rect)
        self.cr.reset_clip()
        self.cr.rectangle(real(r.x), real(r.y), real(r.w), real(r.h))
        self.cr.clip()
    end set_clip

    clear_clip(*self) = self.cr.reset_clip()

    // Rounded up, because a label that is measured one pixel short is a label with its last column
    // clipped off, and the damage pass would then never know the missing column was there.
    text_width(self, s: string) -> int
        var buf: [TEXT_MAX]u8
        var e = text_extents()

        c.text_extents(self.cr.handle, terminate(s, buf[0..<TEXT_MAX]), e.ptr())

        val w = e.x_advance

        int(w) + (if w > real(int(w)) then 1 else 0)
    end text_width

    line_height(self) -> int = self.height

// The longest label this program draws, with room to spare. A label longer than this is cut rather
// than growing storage, which is the bargain every fixed buffer makes and the right one here: the
// alternative is an allocator on the one path that must not have one.
const TEXT_MAX: usize = 128

// A NUL-terminated copy of `s` in storage the caller owns, and a pointer C can take.
//
// This is `sysl.text.cstring` without the heap. It is nine lines because that is all it is -- and
// it is what lets a backend built on a C library still be instantiated into an allocator-free
// library.
private terminate(s: string, into: []u8) -> *u8
    val n = if s.len < into.len - 1 then s.len else into.len - 1

    for i in 0..<n
        into[i] = s[i]

    into[n] = 0
    as_ptr(into)
end terminate

// An `impl` block supplies what the trait asked for and nothing else, so the one helper the four
// primitives share is a function beside them rather than a private member.
private source(cr: &Context, color: u32)
    cr.set_source_rgba(real(color_r(color)) / 255.0, real(color_g(color)) / 255.0,
                       real(color_b(color)) / 255.0, real(color_a(color)) / 255.0)
end source

// ---------------------------------------------------------------------------------------------
// The application's own state. `imui` never sees this -- the widgets are handed a pointer to a
// field and write through it, and there is no copy of any of it anywhere in the library.
// ---------------------------------------------------------------------------------------------

struct App
    tab: int
    backlight: bool
    beep: bool
    invert: bool
    brightness: int
    volume: int
    applied: int
    repainted: int

// ---------------------------------------------------------------------------------------------
// One frame.
//
// **It is generic over the painter, and that is the load-bearing line in this program.** The same
// function runs through the `Recorder` -- which is how the frame gets recorded and how the widgets
// find out what the finger did -- and would run through `CairoPainter` directly if this program did
// not care about damage. Nothing about it is written twice.
// ---------------------------------------------------------------------------------------------

frame[P: Painter](u: *Ui, p: *P, th: Theme, app: *App)
    val screen = Rect(0, 0, W, H)

    p.fill_rect(screen, th.bg)

    var page = layout(screen.inset(th.pad), th.pad)

    label(p, th, page.cut_top(26), "Panel settings", -1)

    var tabs = layout(page.cut_top(36), 0)

    tab(u, p, th, tabs.cut_left_frac(0, 3), "Display", 0, &app.tab)
    tab(u, p, th, tabs.cut_left_frac(1, 3), "Sound", 1, &app.tab)
    tab(u, p, th, tabs.cut_left_frac(2, 3), "About", 2, &app.tab)

    separator(p, th, page.cut_top(9))

    // The three pages are three branches of an ordinary `if`. There is no tree to add and remove
    // widgets from, so switching pages is switching which lines run.
    if app.tab == 0
        toggle(u, p, th, page.cut_top(th.min_touch), "Backlight", &app.backlight)
        toggle(u, p, th, page.cut_top(th.min_touch), "Invert colours", &app.invert)

        label(p, th, page.cut_top(20), "Brightness", -1)
        slider(u, p, th, page.cut_top(th.min_touch), &app.brightness, 0, 100)

        var read = layout(page.cut_top(18), 0)

        muted_label(p, th, read.cut_left(120), "level", -1)
        muted_label(p, th, read.rest(), if app.brightness > 70 then "high"
        else if app.brightness > 30 then "medium"
        else "low", 1)
    else if app.tab == 1
        toggle(u, p, th, page.cut_top(th.min_touch), "Key beep", &app.beep)

        label(p, th, page.cut_top(20), "Volume", -1)
        slider(u, p, th, page.cut_top(th.min_touch), &app.volume, 0, 30)
        progress(p, th, page.cut_top(12), app.volume, 30)
    else
        label(p, th, page.cut_top(22), "imui", -1)
        muted_label(p, th, page.cut_top(20), "immediate mode, no retained tree", -1)
        muted_label(p, th, page.cut_top(20), "no allocation, at all", -1)
        muted_label(p, th, page.cut_top(20), "drawn here by cairo", -1)

    // The readout, and the reason it is at the bottom: it changes on the frames something else
    // changed, so it dirties a band that was going to be repainted anyway.
    var foot = layout(page.cut_bottom(20), 0)

    muted_label(p, th, foot.cut_left(150), "rows repainted", -1)
    muted_label(p, th, foot.rest(), rows_text(app.repainted), 1)

    var row = layout(page.cut_bottom(th.min_touch), th.pad)

    if button(u, p, th, row.cut_left_frac(0, 2), "Reset")
        app.brightness = 50
        app.volume = 15
        app.backlight = true
        app.invert = false
        app.beep = false

    if accent_button(u, p, th, row.cut_left_frac(1, 2), "Apply") then app.applied += 1
end frame

// The readout's text, without building a string -- there is no allocation in this program either,
// which is a promise the library makes and one a demo of it should keep.
private rows_text(n: int) -> string
    if n == 0 then "none"
    else if n <= 30 then "30 of 480"
    else if n <= 60 then "60 of 480"
    else if n <= 120 then "120 of 480"
    else if n <= 240 then "240 of 480"
    else "480 of 480"

// ---------------------------------------------------------------------------------------------

main(args: []string) -> Result[unit, string]
    if args.len > 1 && args[1] == "--shot" then return one_frame_to_png()

    if !sdl3.init(sdl3c.INIT_VIDEO) then return Err(sdl3.error())

    val opened = sdl3.create_window("imui — a 320x480 panel", W, H, 0)

    if opened.is_none() then return Err(sdl3.error())

    var win = opened.unwrap()
    val started = win.create_renderer()

    if started.is_none() then return Err(sdl3.error())

    var r = started.unwrap()
    val made = r.create_texture(sdl3.PixelFormat.Argb8888, sdl3.TextureAccess.Streaming,
                                i32(W), i32(H))

    if made.is_none() then return Err(sdl3.error())

    var tex = made.unwrap()
    var surface = image_surface(Format.Argb32, W, H)
    var cr = context(surface)

    cr.select_font_face("sans", FontSlant.Normal, FontWeight.Normal)
    cr.set_font_size(15.0)

    val fe = cr.font_extents()
    var cp = CairoPainter(cr, fe.ascent, int(fe.height) + 1)

    var u = ui()
    val th = dark()
    var app = App(0, true, false, false, 60, 12, 0, 0)

    // The two command lists. They swap rather than being copied, so a frame costs nothing but the
    // commands it records.
    var buf_a: [MAX_CMDS]Cmd
    var buf_b: [MAX_CMDS]Cmd
    var flip = false
    var prev_n: usize = 0

    var mouse_x = 0
    var mouse_y = 0
    var mouse_down = false
    var nav = 0
    var activate = false
    var running = true

    // The panel starts blank, so the first frame has nothing to be compared with and everything is
    // dirty. Saying so explicitly is better than letting an empty previous list imply it.
    var first = true

    while running
        nav = 0
        activate = false

        var pending = sdl3.poll_event()

        while pending.is_some()
            val e = pending.unwrap()
            val kind = e.kind()

            if kind == sdl3.EventKind.Quit
                running = false
            else if kind == sdl3.EventKind.MouseMotion
                mouse_x = int(e.mouse_x())
                mouse_y = int(e.mouse_y())
            else if kind == sdl3.EventKind.MouseButtonDown
                mouse_x = int(e.mouse_x())
                mouse_y = int(e.mouse_y())
                mouse_down = true
            else if kind == sdl3.EventKind.MouseButtonUp
                mouse_x = int(e.mouse_x())
                mouse_y = int(e.mouse_y())
                mouse_down = false
            else if kind == sdl3.EventKind.KeyDown
                val sc = e.key_scancode()

                if sc == sdl3c.SCANCODE_ESCAPE || sc == sdl3c.SCANCODE_Q then running = false
                else if sc == sdl3c.SCANCODE_TAB || sc == sdl3c.SCANCODE_DOWN then nav = 1
                else if sc == sdl3c.SCANCODE_UP then nav = -1
                else if sc == sdl3c.SCANCODE_RETURN || sc == sdl3c.SCANCODE_SPACE then activate = true

            pending = sdl3.poll_event()

        // ---- record the frame, which is also where the widgets interact ----

        var rec = if flip then recorder(&cp, buf_b[0..<MAX_CMDS]) else recorder(&cp, buf_a[0..<MAX_CMDS])

        rec.reset()
        u.begin(Input(mouse_x, mouse_y, mouse_down, nav, activate))
        frame(&u, &rec, th, &app)
        u.finish()

        // ---- work out what moved ----

        val cur = rec.recorded()
        val prev = if flip then buf_a[0..<prev_n] else buf_b[0..<prev_n]
        val screen = Rect(0, 0, W, H)
        val mask = if first || rec.overflowed then all_bands(BANDS)
        else damage(prev, cur, screen, BANDS)

        // ---- draw and push only the bands that did ----

        var rows = 0
        var band = next_band(mask, BANDS, screen, 0)

        while band.is_some()
            val b = band.unwrap()

            replay(cur, &cp, b.rect)
            surface.flush()
            rows += b.rect.h

            // The desktop's version of writing a window to the panel and streaming it.
            val at = as_ptr(surface.data())
            val stride = surface.stride()
            val row0 = at[usize(b.rect.y * stride)..<usize(b.rect.bottom() * stride)]

            tex.update_rect(sdl3.rect(i32(b.rect.x), i32(b.rect.y), i32(b.rect.w), i32(b.rect.h)),
                            as_ptr(row0), i32(stride))

            band = next_band(mask, BANDS, screen, b.next)

        app.repainted = rows

        r.clear()
        r.copy(tex)
        r.present()

        prev_n = cur.len
        flip = !flip
        first = false

    sdl3.quit()
    Ok(())
end main

// A scripted run with no window: three frames of made-up input through the whole pipeline, the
// third one saved as `demo.png`.
//
// **It goes through the recorder and the damage pass rather than drawing straight through cairo**,
// which is the difference between checking that the widgets draw and checking that the thing this
// library is actually for still works. The row counts it prints are the claim: a frame in which
// nothing moved repaints nothing, and a frame in which one slider moved repaints the bands that
// slider is in and no others.
private one_frame_to_png() -> Result[unit, string]
    var surface = image_surface(Format.Argb32, W, H)
    var cr = context(surface)

    cr.select_font_face("sans", FontSlant.Normal, FontWeight.Normal)
    cr.set_font_size(15.0)

    val fe = cr.font_extents()
    var cp = CairoPainter(cr, fe.ascent, int(fe.height) + 1)
    var u = ui()
    val th = dark()
    var app = App(0, true, false, false, 60, 12, 0, 0)
    var buf_a: [MAX_CMDS]Cmd
    var buf_b: [MAX_CMDS]Cmd
    var flip = false
    var prev_n: usize = 0
    val screen = Rect(0, 0, W, H)

    // The first frame has nothing behind it, then the same input twice, then a finger on the
    // brightness slider.
    for step in 0..<3
        val ev = if step == 2 then pointer(200, 250, true) else pointer(0, 0, false)

        var rec = if flip then recorder(&cp, buf_b[0..<MAX_CMDS])
        else recorder(&cp, buf_a[0..<MAX_CMDS])

        rec.reset()
        u.begin(ev)
        frame(&u, &rec, th, &app)
        u.finish()

        val cur = rec.recorded()
        val prev = if flip then buf_a[0..<prev_n] else buf_b[0..<prev_n]
        val mask = if step == 0 || rec.overflowed then all_bands(BANDS)
        else damage(prev, cur, screen, BANDS)

        var rows = 0
        var band = next_band(mask, BANDS, screen, 0)

        while band.is_some()
            val b = band.unwrap()

            replay(cur, &cp, b.rect)
            rows += b.rect.h
            band = next_band(mask, BANDS, screen, b.next)

        print("frame ", step, ": ", cur.len, " commands, ", rows, " of 480 rows repainted")

        app.repainted = rows
        prev_n = cur.len
        flip = !flip

    surface.flush()

    val wrote = surface.write_png("demo.png")


    if !wrote.ok() then return Err("could not write demo.png")

    print("wrote demo.png")
    Ok(())
end one_frame_to_png
